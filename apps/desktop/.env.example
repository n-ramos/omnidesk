OMNIDESK_APP_PROTOCOL=omnidesk
OMNIDESK_LOG_LEVEL=info

# OmniProxy : backend qui mint les jetons LiveKit pour l'omnichat (appels
# audio/video). Voir le projet OmniProxy (dossier voisin). Optionnel : sans lui,
# l'omnichat est desactive. OMNIDESK_PROXY_API_KEY doit etre identique a
# OMNIPROXY_API_KEY cote proxy.
OMNIDESK_PROXY_URL=http://127.0.0.1:8787
OMNIDESK_PROXY_API_KEY=

# Jeton d'identite omnichat (messagerie native). Requis uniquement si OmniProxy
# active la signature (OMNICHAT_SIGNING_SECRET). Genere cote serveur par
# `pnpm token <votre-email>` ; lie cette installation a votre email (anti-usurpation).
OMNIDESK_OMNICHAT_TOKEN=

# IMAP : interval entre 2 syncs INBOX (60s par defaut).
OMNIDESK_SYNC_INTERVAL_IMAP_SECONDS=60

# Slack et Teams ne sont plus des integrations OAuth : ils s'utilisent en mode web
# (webview persistante, session isolee par compte) via "Ajouter un compte".
# Aucune cle ni secret a configurer pour eux.
