OMNIDESK_APP_PROTOCOL=omnidesk
OMNIDESK_LOG_LEVEL=info

# OmniProxy : backend qui authentifie le compte (mode comptes) et mint les jetons
# LiveKit pour l'omnichat (messagerie native + appels audio/video). Voir le projet
# OmniProxy (dossier voisin). Optionnel : sans lui, la messagerie native et les appels
# sont desactives (le reste de l'app fonctionne sans compte). En mode comptes, la
# connexion se fait par COMPTE (email + mot de passe) depuis l'app : plus aucune cle
# d'API ni jeton partage a configurer ici -- seule l'URL ci-dessous est requise.
OMNIDESK_PROXY_URL=http://127.0.0.1:8787

# IMAP : interval entre 2 syncs INBOX (60s par defaut).
OMNIDESK_SYNC_INTERVAL_IMAP_SECONDS=60

# Slack et Teams ne sont plus des integrations OAuth : ils s'utilisent en mode web
# (webview persistante, session isolee par compte) via "Ajouter un compte".
# Aucune cle ni secret a configurer pour eux.
