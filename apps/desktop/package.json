{
  "name": "@omnidesk/desktop",
  "productName": "Omnidesk",
  "version": "0.5.0",
  "private": true,
  "description": "Omnidesk desktop application.",
  "author": "Omnidesk",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "pnpm typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:native": "electron-builder install-app-deps",
    "package": "electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@vueuse/core": "^13.0.0",
    "electron-log": "^5.3.3",
    "electron-updater": "^6.3.9",
    "emojibase-data": "^17.0.0",
    "grid-layout-plus": "^1.1.1",
    "html-to-text": "^9.0.5",
    "imapflow": "^1.0.171",
    "libsql": "^0.5.29",
    "livekit-client": "^2.19.1",
    "lucide-vue-next": "^0.468.0",
    "mailparser": "^3.7.2",
    "node-emoji": "^2.2.0",
    "nodemailer": "^6.9.16",
    "pinia": "^2.3.0",
    "rss-parser": "^3.13.0",
    "uuid": "^11.0.3",
    "vue": "^3.5.13",
    "vue3-emoji-picker": "^1.1.8",
    "ws": "^8.21.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.2",
    "@types/node-emoji": "^2.1.0",
    "@types/nodemailer": "^6.4.17",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14.1.4",
    "autoprefixer": "^10.4.20",
    "electron": "^42.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.10"
  },
  "build": {
    "appId": "app.omnidesk.desktop",
    "productName": "Omnidesk",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "CHANGELOG.md"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "n-ramos",
        "repo": "omnidesk",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSCameraUsageDescription": "Omnidesk utilise la camera pour les appels omnichat.",
        "NSMicrophoneUsageDescription": "Omnidesk utilise le microphone pour les appels omnichat."
      },
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "protocols": [
        {
          "name": "Omnidesk OAuth Callback",
          "schemes": [
            "omnidesk"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
